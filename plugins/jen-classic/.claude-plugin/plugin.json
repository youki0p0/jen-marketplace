{
  "name": "jen-classic",
  "version": "3.7.0",
  "description": "Jen v3.2 Classic Edition — same PMO orchestration on Opus 4.8 (no Fable required). Compensates Fable's long-horizon strength with re-anchoring, session rotation, and opus council escalation.",
  "author": {
    "name": "Yuukinosh",
    "url": "https://github.com/youki0p0"
  },
  "homepage": "https://github.com/youki0p0/jen-marketplace",
  "repository": "https://github.com/youki0p0/jen-marketplace",
  "license": "MIT",
  "keywords": [
    "orchestrator",
    "pmo",
    "multi-agent",
    "fable",
    "subagents",
    "japanese"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_log.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/stop_append_summary.py"
          }
        ]
      }
    ]
  }
}
{
  "name": "jen-classic",
  "version": "4.0.0",
  "description": "Jen Lean Edition — the same outcome for fewer resources. Runs single-agent by default and delegates only when one agent's effective context would degrade (Tran & Kiela 2026); starts at haiku, escalates on measured REJECT, counts delegations from the hook log. No Fable required. Do not enable alongside jen.",
  "author": {
    "name": "Yuukinosh",
    "url": "https://github.com/youki0p0"
  },
  "homepage": "https://github.com/youki0p0/jen-marketplace",
  "repository": "https://github.com/youki0p0/jen-marketplace",
  "license": "MIT",
  "keywords": [
    "orchestrator",
    "pmo",
    "multi-agent",
    "opus",
    "no-fable",
    "subagents",
    "japanese"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_log.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/stop_append_summary.py"
          }
        ]
      }
    ]
  }
}
